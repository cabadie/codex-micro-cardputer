<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ceciliaabadie.codex-micro-cardputer</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>__PROJECT_ROOT__/bridge/src/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__/bridge</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>StandardOutPath</key>
  <string>__HOME__/.codex-cardputer/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.codex-cardputer/bridge-error.log</string>
</dict>
</plist>
